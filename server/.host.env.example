# Copy this file to .host.env. Keep the copied file private.

# Designate an existing account as DM without changing the database.
VTT_DM_USERNAME=your-host-username

# Optional additional DM usernames, separated by commas:
# VTT_DM_USERNAMES=another-dm,backup-dm

# Or designate by the account UUID:
# VTT_DM_USER_ID=your-account-uuid

# Optional: allow DM account registration using the Register tab.
# Generate one in PowerShell with:
# [Convert]::ToHexString((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# VTT_DM_SETUP_SECRET=paste-the-generated-value-here
