# Copy this file to .cloudflared.env and replace the placeholder values.
# Never commit the copied file or share the tunnel token.

# Use the values from Cloudflare Zero Trust > Networks > Tunnels > CustomVTT.
CLOUDFLARE_TUNNEL_NAME=CustomVTT
CLOUDFLARE_TUNNEL_ID=your-tunnel-uuid
CLOUDFLARE_TUNNEL_URL=https://game.your-real-domain.example

# In Cloudflare dashboard, route that hostname to this local service:
# http://127.0.0.1:5173

# For a remotely-managed tunnel, use the connector token instead of the ID.
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...

# Optional: locally-managed tunnel config containing tunnel and credentials-file.
# CLOUDFLARE_TUNNEL_CONFIG=C:\Users\your-name\.cloudflared\config.yml
