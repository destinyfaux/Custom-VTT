          {
            "name": "Multiattack",
            "description": "Silas makes two attacks with his Weaver's Caduceus."
          },
          {
            "name": "Weaver's Caduceus",
            "description": "Melee Relic Attack: +7 to hit, reach 5 ft., one target. Hit: 7 (1d6 + 4) bludgeoning damage plus 10 (3d6) force damage. If the target is a creature, Silas can choose to push the target up to 10 feet away from him."
          },
          {
            "name": "Gravity Well (Recharge 5-6)",
            "description": "Silas points his Caduceus at a point he can see within 60 feet. A 15-foot-radius sphere of distorted, ghostly cyan gravity erupts at that point. Each creature in that area must make a DC 15 Strength saving throw. On a failure, a creature takes 21 (6d6) force damage, is pulled to the center of the sphere, and is knocked Prone. On a success, a creature takes half damage and isn't pulled or knocked prone."
          }
        ],
        "legendary_actions": [],
        "reactions": [
          {
            "name": "Displacement Slip (3/Day)",
            "description": "When Silas is hit by an attack, he can activate a Sura-Khai relic on his belt. He teleports up to 15 feet to an unoccupied space he can see, leaving a 10-foot-radius cloud of thick grey fog in the space he left. The fog lasts until the end of his next turn, heavily obscuring the area. The triggering attack misses Silas."
          }
        ],
