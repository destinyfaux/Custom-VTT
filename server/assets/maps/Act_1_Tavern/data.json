          {
            "name": "Tactical Monocle",
            "description": "Vex's Sura-Khai ocular eyepiece analyzes weaknesses. Vex's weapon attacks score a critical hit on a roll of 19 or 20. Additionally, his ranged attacks ignore half and three-quarters cover."
          },
          {
            "name": "Brander's Aura",
            "description": "Whenever an unbranded creature starts its turn within 10 feet of Vex, the heat radiating from his heavy basalt gauntlet forces them to make a DC 14 Constitution saving throw, taking 4 (1d8) fire damage on a failed save.\n"
          }
        ],
        "actions": [
          {
            "name": "Multiattack",
            "description": "Vex makes two attacks: one with his Jagged Dredge Blade and one with his Heavy Brander Gauntlet."
          },
          {
            "name": "Jagged Dredge Blade",
            "description": "Melee Weapon Attack: +7 to hit, reach 5 ft., one target. Hit: 11 (2d6 + 4) slashing damage.\n"
          },
          {
            "name": "Heavy Brander Gauntlet",
            "description": "Melee Relic Attack: +7 to hit, reach 5 ft., one target. Hit: 7 (1d6 + 4) bludgeoning damage plus 9 (2d8) fire damage. If the target is a Medium or smaller creature, it is Grappled (escape DC 14). Until this grapple ends, the target takes 9 (2d8) fire damage at the start of each of its turns, and Vex cannot use the gauntlet to attack another target."
          },
          {
            "name": "Dull Crimson Vent (Recharge 5-6)",
            "description": "Vex releases a blast of superheated volcanic gas from his gauntlet in a 15-foot cone. Each creature in that area must make a DC 14 Dexterity saving throw, taking 27 (6d8) fire damage on a failed save, or half as much on a successful one."
          }
        ],
        "legendary_actions": [],
        "reactions": [
          {
            "name": "Tactical Parry",
            "description": "Vex adds 3 to his AC against one melee attack that would hit him. To do so, Vex must see the attacker and be wielding a melee weapon."
          }
