          {
            "name": "Ash-Plume Eruption",
            "description": "When the burrower bursts from the ground, all creatures within 10 feet must succeed on a DC 15 Dexterity saving throw or be blinded by superheated ash until the end of their next turn. Can burrow through solid porous rock, leaving a 10ft tunnel."
          }
        ],
        "actions": [
          {
            "name": "Multiattack",
            "description": "Makes one Bite attack and one Tail Slap attack."
          },
          {
            "name": "Bite",
            "description": "Melee weapon attack: +8 to hit, reach 10ft, one target. Hit: 18 (2d12+5) piercing damage plus 7 (2d6) fire damage. If target is Medium or smaller, it is swallowed whole. While swallowed, creature is blinded and restrained, has total cover against attacks outside burrower, and takes 10 (3d6) acid damage at start of each burrower's turns."
          },
          {
            "name": "Tail Slap",
            "description": "Melee weapon attack: +8 to hit, reach 15ft, one target. Hit: 14 (2d8+5) bludgeoning damage. Target must make DC 15 Strength saving throw or be pushed 15 feet back and knocked prone."
          }
        ],
