          {
            "name": "Stabilizing Chase",
            "description": "When the Ash Drake uses the Dash action, it drops into a quadrupedal stance. Until the start of its next turn, its speed is 60 feet and it has advantage on Dexterity saving throws to navigate difficult or unstable terrain."
          },
          {
            "name": "Skirmish (1/Turn)",
            "description": "The Drake deals an extra 7 (2d6) damage when it hits a target with a weapon attack and has moved at least 20 feet straight toward the target immediately before the hit."
          }
        ],
        "actions": [
          {
            "name": "Multiattack",
            "description": "The Ash Drake makes two Ripping Claw attacks and one Grasping Bite attack."
          },
          {
            "name": "Grasping Bite",
            "description": "Melee weapon attack: +8 to hit, reach 5ft, one target. Hit: 11 (2d6+5) piercing damage. If the target is Medium or smaller, it is grappled (escape DC 16). Until this grapple ends, the Drake can only use its Grasping Bite on that target."
          },
          {
            "name": "Ripping Claws",
            "description": "Melee weapon attack: +8 to hit, reach 5ft, one target. Hit: 14 (2d8+5) slashing damage."
          }
        ],
        "legendary_actions": [],
        "reactions": [
          {
            "name": "Predatory Reflexes",
            "description": "When a creature misses the Ash Drake with a melee attack, the Drake can move up to half its speed without provoking opportunity attacks."
          }
        ],
